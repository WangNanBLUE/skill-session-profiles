{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/dist/hook/session-start.js\"",
            "statusMessage": "Applying project skill configuration",
            "additionalContextLimit": 10000
          }
        ]
      }
    ]
  }
}
